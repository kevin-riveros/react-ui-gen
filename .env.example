# Required: your Anthropic key. With nothing else set, `pnpm dev` works.
# The active model is chosen by the user from the chat UI and validated
# server-side against `src/lib/ai/models.ts` — no env var needed.
ANTHROPIC_API_KEY=

# Dev-only logging. `LOG_LEVEL=debug` enables the Anthropic request/response
# middleware in `src/lib/ai-debug-middleware.ts`. Set DEBUG_AI_FULL_PAYLOAD=true
# to ALSO dump every streamed chunk + full tool schemas (very noisy).
LOG_LEVEL=info
DEBUG_AI_FULL_PAYLOAD=false

# Database. Leave empty for local dev — defaults to a SQLite file at
# ./prisma/dev.db (auto-created by `pnpm dev`). For production/preview,
# point DATABASE_URL at a libSQL-compatible URL (e.g. Turso) and set the
# token.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
