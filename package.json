{
  "name": "react-ui-gen",
  "version": "1.0.0",
  "description": "AI-powered React UI prototyping with pluggable design systems.",
  "license": "MIT",
  "author": {
    "name": "Kevin Riveros",
    "url": "https://github.com/kevin-riveros"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevin-riveros/react-ui-gen.git"
  },
  "bugs": {
    "url": "https://github.com/kevin-riveros/react-ui-gen/issues"
  },
  "homepage": "https://github.com/kevin-riveros/react-ui-gen#readme",
  "keywords": [
    "ai",
    "react",
    "ui-generation",
    "prototyping",
    "design-system",
    "claude",
    "anthropic",
    "nextjs"
  ],
  "scripts": {
    "validate-config": "node scripts/validate-config.mjs",
    "dev": "pnpm run validate-config && node scripts/ensure-assets.mjs && node scripts/ensure-db.mjs && NODE_OPTIONS='--require ./node-compat.cjs' next dev",
    "prebuild": "pnpm run validate-config && pnpm exec prisma generate && node scripts/build-packages.mjs",
    "build": "pnpm run prebuild && NODE_OPTIONS='--require ./node-compat.cjs' next build",
    "vercel-build": "pnpm run build",
    "start": "NODE_OPTIONS='--require ./node-compat.cjs' next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push:local": "node scripts/ensure-db.mjs",
    "db:push:remote": "pnpm exec prisma db push"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.64",
    "@ai-sdk/react": "^3.0.141",
    "@babel/standalone": "^7.27.6",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@heroui/react": "^3.0.3",
    "@heroui/styles": "^3.0.3",
    "@libsql/client": "^0.17.0",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@prisma/adapter-libsql": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@prisma/client-runtime-utils": "^7.7.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@tailwindcss/browser": "^4.2.1",
    "@tailwindcss/typography": "^0.5.19",
    "ai": "^6.0.139",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.38.0",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.7.0",
    "next": "^16.2.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.6",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "throttleit": "^2.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.8",
    "@tailwindcss/cli": "^4.2.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/babel__standalone": "^7.1.9",
    "@types/node": "^25.5.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.27.4",
    "eslint": "^9",
    "eslint-config-next": "^16.2.1",
    "prisma": "^7.7.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
